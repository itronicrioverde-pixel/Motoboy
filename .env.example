# Google Routes API (opcional).
# 1) Google Cloud Console: crie/abra um projeto e ATIVE o billing.
# 2) Ative a "Routes API".
# 3) Crie uma chave de API e RESTRINJA por referenciador HTTP (seu domínio).
# 4) Copie este arquivo para .env e cole a chave abaixo.
# Sem chave, o app usa OSRM/linha reta automaticamente.
VITE_GOOGLE_MAPS_API_KEY= AIzaSyBLul3_LElbl8n4DU8ty3V7JZZM-pdR5Qo

# Firebase Configuration (obrigatório)
# 1) Acesse Firebase Console > Configurações do Projeto > Seus apps
# 2) Copie os valores abaixo para o arquivo .env
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=