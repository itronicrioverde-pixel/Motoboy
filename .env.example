# Firebase (obrigatório — Authentication + Firestore)
# 1) Acesse https://console.firebase.google.com
# 2) Selecione seu projeto > Configurações (engrenagem) > Seus apps
# 3) Copie os valores abaixo
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Routes API (opcional)
# 1) Google Cloud Console > ATIVE billing > ative "Routes API"
# 2) Crie chave de API > RESTRINJA por referenciador HTTP
# Sem chave: app usa OSRM/linha reta automaticamente
VITE_GOOGLE_MAPS_API_KEY=

# GraphHopper Route API (opcional, 500 req/dia grátis)
# 1) Acesse https://www.graphhopper.com/dashboard/#/apikeys
# 2) Crie conta gratuita e gere chave
# Sem chave: app usa OSRM/linha reta automaticamente
VITE_GRAPHHOPPER_API_KEY=
