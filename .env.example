# Firebase (obrigatório — Authentication + Firestore)
# 1) Acesse https://console.firebase.google.com
# 2) Selecione seu projeto > Configurações (engrenagem) > Seus apps
# 3) Copie os valores abaixo
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# HERE Maps — Geocoding (recomendado, 250K req/mês grátis)
# 1) Acesse https://developer.here.com/signup
# 2) Crie conta gratuita (sem cartão de crédito)
# 3) Crie um projeto > gere "Access Key"
# 4) Com isso, o app encontra ruas que o OpenStreetMap não mapeia
#    (ex: "Rua 78, Bairro Popular, Rio Verde")
# Sem chave: app usa Photon/Nominatim (OSM) — funciona mas pode errar ruas pequenas
VITE_HERE_API_KEY=

# Google Routes API (opcional)
# 1) Google Cloud Console > ATIVE billing > ative "Routes API"
# 2) Crie chave de API > RESTRINJA por referenciador HTTP
# Sem chave: app usa OSRM/linha reta automaticamente
VITE_GOOGLE_MAPS_API_KEY=

# GraphHopper Route API (opcional, 500 req/dia grátis)
# 1) Acesse https://www.graphhopper.com/dashboard/#/apikeys
# 2) Crie conta gratuita e gere chave
# Sem chave: app usa OSRM/linha reta automaticamente
VITE_GRAPHHOPPER_API_KEY=
